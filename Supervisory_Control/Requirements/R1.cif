import "../Plant/events.cif";

requirement R1:
  // Stato cabina ferma a un piano
  location stable:
    initial; marked;
    // Se apro/chiudo la porta, rimango qui
    edge openr  goto stable;
    edge close  goto stable;
    // Se arriva un press o arrive, rimango
    edge press_0 goto stable; edge press_1 goto stable; edge press_2 goto stable;
    edge arrive_0 goto stable; edge arrive_1 goto stable; edge arrive_2 goto stable;
    // Se avvio movimento, passo a moving
    edge up    goto moving;
    edge down  goto moving;

  // Stato cabina in movimento
  location moving:
    marked;
    edge up    goto moving;    // doppio up non cambia
    edge down  goto moving;   // doppio down non cambia
    // Arrivo a **qualunque** piano riporta a stable
    edge arrive_0 goto stable;
    edge arrive_1 goto stable;
    edge arrive_2 goto stable;
    // TODO: gli eventi openr/close **non** compaiono  il supervisore li blocca
    // Gli eventi press rimangono permessi da entrambi:
    edge press_0 goto moving; edge press_1 goto moving; edge press_2 goto moving;
end
